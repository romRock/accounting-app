generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================== AUTH ==================

model User {
  id                   String        @id @default(cuid())
  email                String        @unique
  username             String        @unique
  password             String
  firstName            String
  lastName             String
  phone                String?
  isActive             Boolean       @default(true)
  isDeleted            Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  roleId               String
  branchId             String?
  createdAuditLogs     AuditLog[]
  createdLedgerEntries LedgerEntry[] @relation("LedgerCreator")
  createdTransactions  Transaction[] @relation("TransactionCreator")
  userSessions         UserSession[]
  branch               Branch?       @relation(fields: [branchId], references: [id])
  role                 Role          @relation(fields: [roleId], references: [id])

  @@index([email])
  @@index([username])
  @@index([roleId])
  @@index([branchId])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json     // Store RBAC permissions as JSON
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("roles")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("user_sessions")
}

// ================== MASTER ==================

model City {
  id               String        @id @default(cuid())
  name             String
  code             String        @unique
  state            String?
  address          String?       // Auto-generated: name + state
  number           String?       // Contact number or null
  isActive         Boolean       @default(true)
  isDeleted        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transactions     Transaction[] @relation("TransactionCenter")

  @@index([code])
  @@index([name])
  @@map("cities")
}

model Party {
  id                   String        @id @default(cuid())
  name                 String
  phone                String?
  email                String?
  address              String?
  city                 String?       // Client city - separate from cities table
  panNumber            String?
  gstNumber            String?
  isActive             Boolean       @default(true)
  isDeleted            Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  receivedTransactions Transaction[] @relation("ReceiverTransactions")
  sentTransactions     Transaction[] @relation("SenderTransactions")

  @@index([name])
  @@index([city])
  @@index([createdAt])
  @@map("parties")
}

model Branch {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  address       String?
  phone         String?
  email         String?
  isActive      Boolean        @default(true)
  isDeleted     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  balanceSheets BalanceSheet[]
  ledgerEntries LedgerEntry[]
  transactions  Transaction[]
  users         User[]

  @@index([code])
  @@index([createdAt])
  @@map("branches")
}

// ================== TRANSACTIONS ==================

model Transaction {
  id                   String        @id @default(cuid())
  transactionId        String        @unique // PM2_001, PM2_002...
  tokenNo             Int           // Daily token number
  date                 DateTime      // Transaction date
  time                 DateTime      // Transaction time
  centerId             String        // City/center reference
  amount               Int           // Full amount only (no decimals)
  amountType           String        // CASH or CREDIT
  commission           Int           // Total commission
  bookingCommission    Int           // 35% of commission
  centerCommission     Int           // 65% of commission
  autoCommission       Boolean       @default(true)
  receiverName         String        // Receiver name (can be free text)
  receiverNumber       String?       // Optional receiver number
  senderName           String        // Sender name (can be free text)
  senderNumber         String?       // Optional sender number
  receiverClientId     String?       // If receiver is from client list
  senderClientId       String?       // If sender is from client list
  remark               String?       // Optional remark
  status               Boolean       @default(true) // Active/Inactive
  statusTime           DateTime      // Status timestamp
  type                 String        // OUTWARD or INWARD
  isActive             Boolean       @default(true)
  isDeleted            Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  branchId             String?
  createdBy            String
  ledgerEntries        LedgerEntry[]
  branch               Branch?       @relation(fields: [branchId], references: [id])
  creator              User          @relation("TransactionCreator", fields: [createdBy], references: [id])
  center               City          @relation("TransactionCenter", fields: [centerId], references: [id])
  receiverClient       Party?        @relation("ReceiverTransactions", fields: [receiverClientId], references: [id])
  senderClient         Party?        @relation("SenderTransactions", fields: [senderClientId], references: [id])

  @@index([transactionId])
  @@index([date])
  @@index([tokenNo])
  @@index([centerId])
  @@index([receiverClientId])
  @@index([senderClientId])
  @@index([type])
  @@index([status])
  @@index([branchId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("Transaction")
}

model LedgerEntry {
  id            String       @id @default(cuid())
  date          DateTime
  accountId     String
  accountType   String
  description   String
  debitAmount   Float?
  creditAmount  Float?
  balance       Float
  isActive      Boolean      @default(true)
  isDeleted     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  transactionId String?
  branchId      String?
  createdBy     String
  branch        Branch?      @relation(fields: [branchId], references: [id])
  creator       User         @relation("LedgerCreator", fields: [createdBy], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([date])
  @@index([accountId])
  @@index([accountType])
  @@index([transactionId])
  @@index([branchId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("ledger_entries")
}

model CommissionRate {
  id         String   @id @default(cuid())
  fromCityId String
  toCityId   String
  rateType   String
  rate       Float
  minAmount  Float?
  maxAmount  Float?
  isActive   Boolean  @default(true)
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fromCityId])
  @@index([toCityId])
  @@index([rateType])
  @@index([createdAt])
  @@map("commission_rates")
}

// ================== REPORTING ==================

model BalanceSheet {
  id               String   @id @default(cuid())
  date             DateTime
  openingBalance   Float
  closingBalance   Float
  totalAssets      Float
  totalLiabilities Float
  totalEquity      Float
  branchId         String?
  isActive         Boolean  @default(true)
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  branch           Branch?  @relation(fields: [branchId], references: [id])

  @@index([date])
  @@index([branchId])
  @@index([createdAt])
  @@map("balance_sheets")
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  oldValues String?
  newValues String?
  ipAddress String?
  userAgent String?
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id])

  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdBy])
  @@index([createdAt])
  @@map("audit_logs")
}
