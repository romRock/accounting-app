{
  "name": "backend",
  "version": "1.0.0",
  "description": "Accounting App Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/production-build.js",
    "start": "node dist/index.js",
    "dev": "nodemon src/index-simple.ts",
    "dev:prisma": "nodemon src/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:cities": "tsx src/seedCities.ts",
    "db:seed:roles": "tsx prisma/seeds/rbac-roles.seed.ts",
    "db:seed:cities:production": "tsx scripts/seed-cities-production.ts",
    "db:seed:clients:production": "tsx scripts/seed-clients-production.ts",
    "db:seed:roles:production": "tsx scripts/seed-roles-production.ts",
    "db:seed:users:production": "tsx scripts/seed-users-production.ts",
    "db:migrate:permissions": "node scripts/permissions-migration.js",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "accounting",
    "fintech",
    "angadiya"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "prisma": "^5.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
