generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id @default(cuid())
  email                String        @unique
  username             String        @unique
  password             String
  firstName            String
  lastName             String
  phone                String?
  isActive             Boolean       @default(true)
  isDeleted            Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  roleId               String
  branchId             String?
  createdAuditLogs     AuditLog[]
  createdLedgerEntries LedgerEntry[] @relation("LedgerCreator")
  userSessions         UserSession[]
  branch               Branch?       @relation(fields: [branchId], references: [id])
  role                 Role          @relation(fields: [roleId], references: [id])

  @@index([email])
  @@index([username])
  @@index([roleId])
  @@index([branchId])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  permissions Json
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("roles")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("user_sessions")
}

model City {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  state     String?
  address   String?
  number    String?
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([name])
  @@map("cities")
}

model Party {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  city      String?
  panNumber String?
  gstNumber String?
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([city])
  @@index([createdAt])
  @@map("parties")
}

model Branch {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  address       String?
  phone         String?
  email         String?
  isActive      Boolean        @default(true)
  isDeleted     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  balanceSheets BalanceSheet[]
  ledgerEntries LedgerEntry[]
  users         User[]

  @@index([code])
  @@index([createdAt])
  @@map("branches")
}

model Transaction {
  id                String   @id @default(cuid())
  transactionId     String   @unique
  tokenNo           Int?
  date              DateTime
  time              DateTime
  centerId          String
  amount            Int
  amountType        String
  commission        Int      @default(0)
  bookingCommission Int      @default(0)
  centerCommission  Int      @default(0)
  autoCommission    Boolean  @default(true)
  receiverName      String
  receiverNumber    String?
  senderName        String
  senderNumber      String?
  receiverClientId  String?
  senderClientId    String?
  remark            String?
  status            Boolean  @default(true)
  statusTime        DateTime
  type              String   @default("OUTWARD")
  isActive          Boolean  @default(true)
  isDeleted         Boolean  @default(false)
  branchId          String?
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([transactionId])
  @@index([date])
  @@index([centerId])
  @@index([createdBy])
  @@map("Transaction")
}

model Hawala {
  id              String   @id @default(cuid())
  transactionId   String   @unique
  tokenNo         Int?
  date            DateTime
  time            DateTime
  partyA          String
  partyB          String
  amount          Int
  remark          String?
  status          Boolean  @default(true)
  statusTime      DateTime
  isActive        Boolean  @default(true)
  isDeleted       Boolean  @default(false)
  branchId        String?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([transactionId])
  @@index([date])
  @@index([partyA])
  @@index([partyB])
  @@index([createdBy])
  @@map("Hawala")
}

model LedgerEntry {
  id            String   @id @default(cuid())
  date          DateTime
  accountId     String
  accountType   String
  description   String
  debitAmount   Float?
  creditAmount  Float?
  balance       Float
  isActive      Boolean  @default(true)
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  transactionId String?
  branchId      String?
  createdBy     String
  branch        Branch?  @relation(fields: [branchId], references: [id])
  creator       User     @relation("LedgerCreator", fields: [createdBy], references: [id])

  @@index([date])
  @@index([accountId])
  @@index([accountType])
  @@index([transactionId])
  @@index([branchId])
  @@index([createdBy])
  @@index([createdAt])
  @@map("ledger_entries")
}

model CommissionRate {
  id         String   @id @default(cuid())
  fromCityId String
  toCityId   String
  rateType   String
  rate       Float
  minAmount  Float?
  maxAmount  Float?
  isActive   Boolean  @default(true)
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fromCityId])
  @@index([toCityId])
  @@index([rateType])
  @@index([createdAt])
  @@map("commission_rates")
}

model BalanceSheet {
  id               String   @id @default(cuid())
  date             DateTime
  openingBalance   Float
  closingBalance   Float
  totalAssets      Float
  totalLiabilities Float
  totalEquity      Float
  branchId         String?
  isActive         Boolean  @default(true)
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  branch           Branch?  @relation(fields: [branchId], references: [id])

  @@index([date])
  @@index([branchId])
  @@index([createdAt])
  @@map("balance_sheets")
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  oldValues String?
  newValues String?
  ipAddress String?
  userAgent String?
  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  createdBy String
  creator   User     @relation(fields: [createdBy], references: [id])

  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdBy])
  @@index([createdAt])
  @@map("audit_logs")
}
